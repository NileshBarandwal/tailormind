# Required — AI model providers
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Required — Job discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Production — CORS (set to your Vercel URL in production)
# Leave empty or "*" for local development
ALLOWED_ORIGINS=

# Optional — Audit log database (Supabase)
# Leave empty to skip Supabase logging (file-based logging still works)
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
